# Read automatically by `npm run build` (on Vercel too). None of these is a secret.
#
# The API's address as a browser reaches it. The site (privlee.com) and the API are separate.
VITE_API_URL=https://api.privlee.com
# The site's own public address: drives canonical links, og:url and the sitemap (once open).
VITE_SITE_URL=https://privlee.com
# "closed" keeps the whole site out of search engines (robots.txt disallows everything, every page is
# noindex). Change to "open" when you are ready to be found.
VITE_SITE_MODE=closed
# Google sign-in (a public identifier, not a secret). Needs https://privlee.com added under
# Authorized JavaScript origins for this client in Google Cloud.
VITE_GOOGLE_CLIENT_ID=950752784266-h2qp8j7j12aikoghljana85jh9u0o1ts.apps.googleusercontent.com
# Added once Search Console / Bing give them out:
#   VITE_GOOGLE_SITE_VERIFICATION=...
#   VITE_BING_SITE_VERIFICATION=...
